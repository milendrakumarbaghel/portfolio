# Contact form (Vercel → Project → Settings → Environment Variables)
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=
# Where enquiries are delivered (defaults to baghelmilendrakumar@gmail.com)
CONTACT_TO_EMAIL=
# Sender. Use a verified domain in Resend, e.g. "Portfolio <hello@milendra.site>".
# Without a verified domain Resend only allows onboarding@resend.dev → your own account email.
CONTACT_FROM_EMAIL=
# Extra allowed origins for the API, comma-separated (the deploying host is always allowed)
ALLOWED_ORIGINS=
